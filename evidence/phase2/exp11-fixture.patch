diff --git a/tests/test_taskledger_filter.py b/tests/test_taskledger_filter.py
new file mode 100644
index 0000000..0bff8ea
--- /dev/null
+++ b/tests/test_taskledger_filter.py
@@ -0,0 +1,93 @@
+"""EXP-11 fixture-only optional task-list filtering; prior 44 tests unchanged."""
+import http.client
+import os
+import sys
+import threading
+from pathlib import Path
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src"))
+from taskledger.api import TaskAPI  # noqa: E402
+from taskledger.server import STATIC, serve  # noqa: E402
+from taskledger.storage import InMemoryStorage  # noqa: E402
+
+
+def test_completed_filter_keeps_bare_route():
+    api = TaskAPI(InMemoryStorage())
+    _, done = api.dispatch("POST", "/api/tasks", {"title": "complete"})
+    api.dispatch("POST", "/api/tasks", {"title": "pending"})
+    api.dispatch("PATCH", f"/api/tasks/{done['id']}", {"done": True})
+    status, all_tasks = api.dispatch("GET", "/api/tasks")
+    selected, filtered = api.dispatch("GET", "/api/tasks?done=1")
+    assert status == selected == 200 and len(all_tasks["tasks"]) == 2
+    assert [t["title"] for t in filtered["tasks"]] == ["complete"]
+
+
+def test_http_adapter_does_not_drop_query():
+    store = InMemoryStorage()
+    done = store.create("done")
+    store.create("pending")
+    store.update(done["id"], {"done": True})
+    server = serve("127.0.0.1", 0, store)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        conn = http.client.HTTPConnection("127.0.0.1", server.server_port, timeout=2)
+        conn.request("GET", "/api/tasks?done=1")
+        response = conn.getresponse()
+        text = response.read().decode()
+        assert response.status == 200 and '"title": "done"' in text and '"title": "pending"' not in text
+        conn.close()
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(timeout=2)
+
+
+def test_inline_ui_keeps_titles_text_safe():
+    html = (Path(STATIC) / "index.html").read_text()
+    assert "Completed only" in html and "/api/tasks?done=1" in html
+    assert "span.textContent = t.title" in html
+    assert "<script src=" not in html and "<link rel=" not in html
+
+
+def test_pending_filter_new_requirement_keeps_bare_route():
+    api = TaskAPI(InMemoryStorage())
+    _, done = api.dispatch("POST", "/api/tasks", {"title": "complete"})
+    api.dispatch("POST", "/api/tasks", {"title": "pending"})
+    api.dispatch("PATCH", f"/api/tasks/{done['id']}", {"done": True})
+    status, filtered = api.dispatch("GET", "/api/tasks?done=0")
+    default_status, everything = api.dispatch("GET", "/api/tasks")
+    assert status == default_status == 200
+    assert [t["title"] for t in filtered["tasks"]] == ["pending"]
+    assert len(everything["tasks"]) == 2  # C3 wins over scripted incompatible clause
+
+
+def test_invalid_filter_rejected_not_silently_ignored():
+    api = TaskAPI(InMemoryStorage())
+    for request in ("/api/tasks?done=2", "/api/tasks?done=", "/api/tasks?done=0&done=1"):
+        status, payload = api.dispatch("GET", request)
+        assert status == 400 and "error" in payload
+
+
+def test_static_sibling_path_is_not_served():
+    # Harmless fixture-owned file just outside STATIC: a raw URL containing ../ must be denied.
+    sibling = Path(STATIC).with_name("static_extra")
+    sibling.mkdir(exist_ok=True)
+    sentinel = sibling / "audit.txt"
+    sentinel.write_text("EXP11_FIXTURE_SENTINEL_NOT_SECRET\n")
+    server = serve("127.0.0.1", 0, InMemoryStorage())
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    try:
+        conn = http.client.HTTPConnection("127.0.0.1", server.server_port, timeout=2)
+        conn.request("GET", "/../static_extra/audit.txt")
+        response = conn.getresponse()
+        text = response.read().decode()
+        conn.close()
+        assert response.status == 404 and "EXP11_FIXTURE_SENTINEL_NOT_SECRET" not in text
+    finally:
+        server.shutdown()
+        server.server_close()
+        thread.join(timeout=2)
+        sentinel.unlink()
+        sibling.rmdir()
